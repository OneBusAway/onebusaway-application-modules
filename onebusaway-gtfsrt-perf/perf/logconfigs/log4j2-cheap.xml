<!--
  Config B (cheap pattern). IDENTICAL to log4j2-prod.xml except the layout drops
  the [%F:%L] location converter, substituting the (cheap, cached) logger name
  %c{1}. Same Root=info, same appender, same flood volume. The A - B wall-clock
  delta isolates the cost of location computation alone.
-->
<Configuration>
    <Appenders>
        <Console name="stdout" target="SYSTEM_OUT">
            <PatternLayout pattern="[TDF] %d{ISO8601} %-5p %c{1} : %m%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="info">
            <AppenderRef ref="stdout"/>
        </Root>
    </Loggers>
</Configuration>
