<!--
  Config A (prod-faithful). Mirrors the production tdf-log4j2.xml copied by
  agency-dockerfiles/test-organization-1/Dockerfile line 4: Root=info and the
  [%F:%L] location converter (file + line number). Per the Log4j2 manual, %F and
  %L are "an expensive operation and not garbage-free": each event walks the
  stack and allocates. Sync (default) so the cost lands on the calling thread,
  exactly as in production. The prod RollingFile appender to /opt/oba/logs is
  dropped (path absent off-container); Console keeps the identical [%F:%L] pattern.
-->
<Configuration>
    <Appenders>
        <Console name="stdout" target="SYSTEM_OUT">
            <PatternLayout pattern="[TDF] %d{ISO8601} %-5p [%F:%L] : %m%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="info">
            <AppenderRef ref="stdout"/>
        </Root>
    </Loggers>
</Configuration>
